{
  "name": "nasco",
  "version": "2.1.2",
  "description": "Next.js basic component library — prestyled, typed and zero-config. Import the components and one stylesheet, done.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles/main.css -o ./dist/index.css --minify && node scripts/bump-media-specificity.mjs",
    "build:lib": "npm run build:js && npm run build:css",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "highlight.js": "^11.10.0",
    "next-themes": "^0.4.6",
    "swiper": "^11.1.14",
    "tailwind-merge": "^2.5.2"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "next": "^14.2.13",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tslib": "^2.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  },
  "author": {
    "name": "Clemens Huck",
    "email": "mail@c-huck.com",
    "url": "https://github.com/clemensgoering/nasco"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clemensgoering/nasco.git"
  },
  "homepage": "https://nasco-docu.vercel.app",
  "bugs": {
    "url": "https://nasco-docu.vercel.app/contact"
  },
  "license": "MIT",
  "keywords": [
    "nextjs",
    "next",
    "react",
    "typescript",
    "tailwindcss",
    "components",
    "ui",
    "library",
    "motion"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ]
}
